# Worker environment — do NOT commit real values
DATABASE_URL=postgres://stockwatch_worker:password@localhost:5432/stockwatch
ALPACA_API_KEY_ID=your-alpaca-key-id
ALPACA_API_SECRET_KEY=your-alpaca-secret-key

# Model renderer (architecture §F.7.1) — optional. Leave GEMINI_API_KEY unset to
# run template-only; every brief is then the deterministic template and nothing
# else about the product changes. Worker-only: the API must never call a model.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=10000

NODE_ENV=development
LOG_LEVEL=info
